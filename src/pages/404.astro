---
import Site from '../layouts/Site.astro';
import { route } from '../lib/site';
---
<Site title="Page not found" description="Return to the Hewberry Alarms website concept.">
  <section class="page-lead">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="display">Page not found.</h1>
      <p class="page-lead__text">Explore security services or find help with your existing system.</p>
      <div class="page-actions">
        <a class="button button--amber" href={route()}>Back to home <span aria-hidden="true">↗</span></a>
        <a class="inline-link" href={route('support/')}>Customer support <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Site>
