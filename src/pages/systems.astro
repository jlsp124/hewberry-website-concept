---
import Site from '../layouts/Site.astro';
import AjaxEquipment from '../components/AjaxEquipment.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { route } from '../lib/site';
import '../styles/systems.css';

const installations = [
  { title: 'Homes', detail: 'Alarms, cameras and monitoring for your home.', href: 'residential/', image: 'home', alt: 'Exterior of a modern home' },
  { title: 'Businesses', detail: 'Video, alarm monitoring and access for your team.', href: 'commercial/', image: 'business', alt: 'A keypad at a commercial entry' },
  { title: 'New builds', detail: 'Security and network wiring while the walls are open.', href: 'construction/', image: 'build', alt: 'Timber framing inside a building under construction' },
];
---

<Site title="Systems" description="Explore the security systems Hewberry installs for homes, businesses and new builds in the Okanagan.">
  <section class="systems shell" aria-labelledby="systems-title">
    <div class="systems__intro">
      <h1 id="systems-title">Security systems.</h1>
      <div>
        <p>From a home alarm to a wired commercial site, we’ll choose the equipment around the property and how you use it.</p>
        <a class="plain-link" href="#equipment">Explore equipment <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="systems__installations">
      {installations.map(({ title, detail, href, image, alt }) => (
        <article class="systems__installation">
          <picture>
            <source srcset={`${route(`images/story/${image}-700.webp`)} 700w, ${route(`images/story/${image}-1400.webp`)} 1400w`} sizes="(min-width: 760px) 30vw, 100vw" />
            <img src={route(`images/story/${image}-700.webp`)} alt={alt} width="1400" height="880" decoding="async" loading="lazy" />
          </picture>
          <h2><a href={route(href)}>{title}<span aria-hidden="true">↗</span></a></h2>
          <p>{detail}</p>
        </article>
      ))}
    </div>
  </section>
  <AjaxEquipment />
  <QuoteBand title="Need help choosing a system?" text="Tell us what you’re looking to protect." />
</Site>
