---
import Site from '../layouts/Site.astro';
import { footage, photos } from '../lib/photos';

const images = [...Object.entries(footage), ...Object.entries(photos)] as const;
---
<Site title="Media credits" description="Sources and creators of photography and footage for the Hewberry Alarms website concept.">
  <section class="page-lead">
    <div class="shell">
      <p class="eyebrow">About this concept</p>
      <h1 class="display">Media credits.</h1>
      <p class="page-lead__text">The photos and footage show real places in an illustrative story. The source repository records their licences.</p>
    </div>
  </section>
  <section class="section-space">
    <div class="shell">
      <div class="credits-list">
        {images.map(([id, photo]) => (
          <article id={id}>
            <h2>{photo.caption}</h2>
            <p>
              {photo.author} · {photo.license}
            </p>
          </article>
        ))}
        <article>
          <h2>Equipment and installation imagery</h2>
          <p>Ajax Systems public press and product imagery. The alarm walkthrough includes an original 3D illustration of the Hub 2.</p>
        </article>
      </div>
    </div>
  </section>
</Site>
