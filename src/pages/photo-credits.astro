---
import Site from '../layouts/Site.astro';
import { openingPhoto, photos } from '../lib/photos';

const images = [['home-at-dusk', openingPhoto], ...Object.entries(photos)] as const;
---
<Site title="Photography credits" description="Sources, photographers and reuse terms for the photographs in the Hewberry Alarms website concept.">
  <section class="page-lead">
    <div class="shell">
      <p class="eyebrow">About this concept</p>
      <h1 class="display">Photography credits.</h1>
      <p class="page-lead__text">The photographs are illustrative and show real properties and places. The preview’s source repository records their licences.</p>
    </div>
  </section>
  <section class="section-space">
    <div class="shell">
      <div class="credits-list">
        {images.map(([id, photo]) => (
          <article id={id}>
            <h2>{photo.caption}</h2>
            <p>
              {photo.author} · {photo.license}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Site>
