---
import Site from '../layouts/Site.astro';
import FAQList from '../components/FAQList.astro';
import { company, route } from '../lib/site';
---
<Site title="Customer support" description="Contact the Hewberry Alarms Vernon office for system service and account questions. Find the right contact for your monitored alarm.">
  <section class="page-lead" aria-labelledby="page-title">
    <div class="shell">
      <p class="eyebrow">Existing customers</p>
      <h1 id="page-title" class="display">Customer support.</h1>
      <p class="page-lead__text">Need help with an installed system, a bill or your monitoring account? Here’s who to call.</p>
    </div>
  </section>
  <section class="support-options section-space" aria-label="Contact options">
    <div class="shell support-options__grid">
      <article>
        <h2>Service and office enquiries</h2>
        <p>For repairs, upgrades, parts, billing or general questions, contact Hewberry’s Vernon office.</p>
        <a class="inline-link support-phone" href={company.telephone}>{company.phone} <span aria-hidden="true">↗</span></a>
        <a class="support-email" href={'mailto:' + company.email}>{company.email}</a>
        <p class="support-hours">Call to confirm current office hours.</p>
      </article>
      <article>
        <h2>Monitored alarm or account</h2>
        <p>For an alarm event, testing instructions or a change to your emergency contacts, use the monitoring station number on your account paperwork. Call Hewberry if you need help finding it.</p>
        <p><strong>For an immediate threat to life or safety, call <a href="tel:911">911</a>.</strong></p>
        <a class="inline-link" href={company.currentContact}>Official Hewberry contact page <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>
  <FAQList all />
  <section class="quote-band" aria-label="New projects">
    <div class="shell quote-band__inner">
      <div><h2>Planning a new system?</h2><p>Choose the kind of property and what you’d like help with.</p></div>
      <a class="button button--dark" href={route('quote/')}>Get a quote <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</Site>
