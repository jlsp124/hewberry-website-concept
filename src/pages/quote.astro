---
import Site from '../layouts/Site.astro';
import { company, route } from '../lib/site';
import { priorities, properties } from '../lib/quote';
---
<Site title="Get a quote" description="Try the guided Hewberry Alarms quote experience for home, business or construction security. Submissions are simulated.">
  <div class="shell quote-layout">
    <div class="quote-intro">
      <h1 class="display">Get a quote.</h1>
      <p>Choose your property type and what you’d like help with.</p>
      <p class="demo-note"><strong>Demo only.</strong> Your choices stay on this page.</p>
      <a class="inline-link" href={company.telephone}>Call {company.phone} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="quote-panel">
      <div data-quote-fallback>
        <h2>Talk to Hewberry</h2>
        <p>The interactive preview needs JavaScript. You can also contact Hewberry directly about your project.</p>
        <a class="inline-link" href={company.currentContact}>Hewberry’s contact page <span aria-hidden="true">↗</span></a>
      </div>
      <div data-quote hidden>
        <ol class="quote-progress" aria-label="Quote progress">
          <li aria-current="step"><span aria-hidden="true">1</span>Property</li>
          <li><span aria-hidden="true">2</span>Priorities</li>
          <li><span aria-hidden="true">3</span>Review</li>
        </ol>
        <section data-quote-step="0" aria-labelledby="property-title">
          <h2 id="property-title" tabindex="-1">What are you looking to protect?</h2>
          <fieldset aria-labelledby="property-title" aria-describedby="property-error">
            {properties.map(({ value, label, description }) => (
              <label class="choice">
                <input type="radio" value={value} name="property" data-label={label} />
                <span><strong>{label}</strong><small>{description}</small></span>
              </label>
            ))}
          </fieldset>
          <p id="property-error" class="quote-error" role="alert"></p>
          <div class="quote-controls">
            <button class="button button--dark" type="button" data-next>Continue <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <section data-quote-step="1" aria-labelledby="priority-title" hidden>
          <h2 id="priority-title" tabindex="-1">What would you like help with?</h2>
          <p id="priority-hint" class="quote-hint">Choose what fits, or select “Help me decide”.</p>
          <fieldset aria-labelledby="priority-title" aria-describedby="priority-hint priority-error" class="quote-priorities">
            {priorities.map(({ value, label, description }) => (
              <label class="choice">
                <input type="checkbox" value={value} name="priority" data-label={label} />
                <span><strong>{label}</strong><small>{description}</small></span>
              </label>
            ))}
          </fieldset>
          <p id="priority-error" class="quote-error" role="alert"></p>
          <div class="quote-controls">
            <button class="back-button" type="button" data-back><span aria-hidden="true">←</span> Back</button>
            <button class="button button--dark" type="button" data-next>Review choices <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <section data-quote-step="2" aria-labelledby="review-title" hidden>
          <h2 id="review-title" tabindex="-1">Review your choices.</h2>
          <dl class="quote-review">
            <dt>Property</dt>
            <dd data-review-property></dd>
            <dt>Priorities</dt>
            <dd><ul data-review-priorities></ul></dd>
          </dl>
          <p class="quote-hint">This will show a sample confirmation on this page.</p>
          <div class="quote-controls">
            <button class="back-button" type="button" data-back><span aria-hidden="true">←</span> Back</button>
            <button class="button button--dark" type="button" data-submit>Simulate submission <span aria-hidden="true">↗</span></button>
          </div>
        </section>
        <section data-quote-step="3" aria-labelledby="done-title" hidden>
          <h2 id="done-title" tabindex="-1">Demo request complete.</h2>
          <p>Your choices stayed on this page. To discuss a real quote, contact Hewberry’s Vernon office at <a href={company.telephone}>{company.phone}</a>.</p>
          <div class="quote-controls quote-controls--done">
            <button class="button button--dark" type="button" data-reset>Start again <span aria-hidden="true">↗</span></button>
            <a class="inline-link" href={route('#services')}>Explore services <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </div>
    </div>
  </div>
</Site>
<script>
  import { initializeQuote } from '../scripts/quote';
  initializeQuote();
</script>
