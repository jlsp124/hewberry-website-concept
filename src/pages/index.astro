---
import Site from '../layouts/Site.astro';
import EveningOpening from '../components/EveningOpening.astro';
import SecurityFact from '../components/SecurityFact.astro';
import SignalStory from '../components/SignalStory.astro';
import InstallationShowcase from '../components/InstallationShowcase.astro';
import EveningContact from '../components/EveningContact.astro';
import '../styles/home.css';
---
<Site
  home
  title="Hewberry Alarms | Security installation and monitoring in Vernon, BC"
  description="Hewberry Alarms installs security systems, cameras and door access and provides 24/7 alarm monitoring for homes and businesses in Vernon and the Okanagan."
>
  <EveningOpening />
  <SecurityFact />
  <SignalStory />
  <InstallationShowcase />
  <section class="home-testimonial" aria-label="Customer testimonial">
    <div class="shell home-testimonial__inner">
      <figure>
        <blockquote>“Hewberry Alarms provided excellent and timely service, advising us on the best options for our new home…”</blockquote>
        <figcaption><span aria-hidden="true"></span><strong>Jack Ledbetter</strong> <span>Homeowner</span></figcaption>
      </figure>
    </div>
  </section>
  <EveningContact />
</Site>
