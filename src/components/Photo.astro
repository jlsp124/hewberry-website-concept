---
import { route } from '../lib/site';
import { photos } from '../lib/photos';
interface Props { image: keyof typeof photos; sizes?: string }
const { image, sizes = '(min-width: 850px) 45vw, 94vw' } = Astro.props;
const { alt, caption } = photos[image];
const small = route('images/' + image + '-640.webp');
const large = route('images/' + image + '-1050.webp');
---
<figure class="photo">
  <img
    src={small}
    srcset={small + ' 640w, ' + large + ' 1050w'}
    sizes={sizes}
    width="1050"
    height="840"
    loading="lazy"
    decoding="async"
    alt={alt}
  />
  <figcaption>{caption}</figcaption>
</figure>
