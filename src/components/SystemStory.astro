---
import { systemChapters } from '../lib/equipment';
import { company, route } from '../lib/site';
import Photo from './Photo.astro';

const first = systemChapters[0];
const chapterId = (id: string) => 'system-' + id;
const stageSource = (image: string) => route('images/' + image + '-1050.webp');
---
<section id="system" class="system-story section-space" aria-labelledby="system-title" tabindex="-1" data-system-story>
  <div class="shell">
    <div class="system-story__intro">
      <div>
        <p class="eyebrow">Inside a security system</p>
        <h2 id="system-title" class="display">From the door<br class="wide-break" /> to the call.</h2>
      </div>
      <p>See what each piece does and how it can fit into a system Hewberry installs and services.</p>
    </div>
    <nav class="system-index" aria-label="Security system chapters">
      {systemChapters.map(({ id, label }) => (
        <a href={'#' + chapterId(id)} data-chapter-link={id}>{label}</a>
      ))}
    </nav>
    <div class="system-story__body">
      <div class="system-stage" aria-hidden="true" data-stage>
        <div class="system-stage__image">
          <img src={stageSource(first.photo)} width="1050" height="840" loading="lazy" decoding="async" alt="" data-stage-image />
        </div>
        <div class="system-stage__label">
          <span class="story-point"></span><span data-stage-label>{first.label}</span>
          <span class="system-stage__progress"></span>
        </div>
      </div>
      <div class="system-chapters">
        {systemChapters.map(({ id, label, title, text, equipment, photo, link, action }, index) => (
          <article class="system-chapter" id={chapterId(id)} data-chapter={id} data-label={label} data-src={stageSource(photo)} data-progress={(index + 1) / systemChapters.length}>
            <p class="eyebrow">{label}</p>
            <h3>{title}</h3>
            <p>{text}</p>
            <Photo image={photo} class="system-chapter__photo" sizes="(min-width: 601px) 48vw, 89vw" />
            <div class="system-chapter__equipment">
              <p><strong>Equipment and service</strong> {equipment}</p>
              <a class="inline-link" href={route(link)}>{action} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="system-story__contact">
      <h3>Plan a system with Hewberry.</h3>
      <div class="hero__actions">
        <a class="button button--amber" href={route('quote/')}>Get a quote <span aria-hidden="true">↗</span></a>
        <a class="inline-link" href={company.telephone}>Call {company.phone}</a>
      </div>
    </div>
  </div>
</section>
<script>
  const story = document.querySelector<HTMLElement>('[data-system-story]');
  const stage = story?.querySelector<HTMLElement>('[data-stage]');
  const picture = stage?.querySelector<HTMLImageElement>('[data-stage-image]');
  const label = stage?.querySelector<HTMLElement>('[data-stage-label]');
  const chapters = story?.querySelectorAll<HTMLElement>('[data-chapter]');
  const chapterLinks = story?.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]');
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');

  if (story && stage && picture && label && chapters && chapterLinks && typeof IntersectionObserver !== 'undefined') {
    let active = '';
    const show = (chapter: HTMLElement) => {
      const { chapter: id, src, label: name, progress } = chapter.dataset;
      if (!id || !src || !name || !progress || active === id) return;
      active = id;
      stage.dataset.scene = id;
      stage.style.setProperty('--story-progress', progress);
      if (picture.getAttribute('src') !== src) picture.src = src;
      label.textContent = name;
      chapterLinks.forEach((link) => {
        if (link.dataset.chapterLink === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    picture.addEventListener('load', () => {
      if (motion.matches && stage.getClientRects().length) {
        picture.animate(
          [{ opacity: .55, transform: 'scale(1.018)' }, { opacity: 1, transform: 'scale(1)' }],
          { duration: 360, easing: 'ease-out' },
        );
      }
    });
    let observer: IntersectionObserver | undefined;
    const watchChapters = () => {
      observer?.disconnect();
      const top = Math.round(innerHeight * .4);
      const bottom = Math.round(innerHeight * .54);
      const rootMargin = '-' + top + 'px 0px -' + bottom + 'px 0px';
      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) show(entry.target);
        }
      }, { rootMargin });
      chapters.forEach((chapter) => observer?.observe(chapter));
    };
    const firstChapter = chapters[0];
    if (firstChapter) show(firstChapter);
    story.dataset.enhanced = 'true';
    watchChapters();
    window.addEventListener('resize', watchChapters, { passive: true });
  }
</script>
