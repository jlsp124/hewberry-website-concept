---
import SignalSequence from './SignalSequence.astro';
import { route } from '../lib/site';
---
<section class="monitoring section-space" aria-labelledby="monitoring-heading">
  <div class="shell monitoring__inner">
    <div class="monitoring__intro">
      <div>
        <h2 id="monitoring-heading" class="display">When an alarm goes off.</h2>
      </div>
      <div class="monitoring__detail">
        <p>Ask Hewberry what your system can report and who you’d like the monitoring operator to call.</p>
        <a class="inline-link" href={route('support/')}>Help with an existing system <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <SignalSequence />
  </div>
</section>
