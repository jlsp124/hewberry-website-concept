---
import { route } from '../lib/site';

interface Props {
  href?: string;
  title?: string;
  text?: string;
}

const {
  href = 'contact/',
  title = 'Let’s talk about your property.',
  text = 'Tell us what you’d like to protect. We’ll help you narrow down the options.',
} = Astro.props;
---
<section class="quote-band" aria-label="Request a quote">
  <div class="shell quote-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="button button--dark" href={route(href)}>Get a quote <span class="arrow" aria-hidden="true">↗</span></a>
  </div>
</section>
