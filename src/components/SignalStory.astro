---
import { route } from '../lib/site';
---

<section class="alarm-film" id="system" data-alarm-film aria-label="How a monitored alarm works">
  <div class="alarm-film__screen" data-alarm-screen>
    <article id="signal-door" class="alarm-scene alarm-scene--door" aria-labelledby="signal-title-door" data-alarm-scene data-layer="current">
      <div class="alarm-scene__field" aria-hidden="true">
        <img src={route('images/story/door-film-poster.webp')} alt="" width="1120" height="630" decoding="async" loading="lazy" />
        <video data-door-film data-src={route('images/story/door-motion.mp4')} muted playsinline preload="none"></video>
      </div>
      <div class="shell alarm-scene__inside">
        <div class="alarm-scene__copy">
          <p class="signal-eyebrow">Detection</p>
          <h2 id="signal-title-door">It starts<br class="alarm-line-break" /> at the door.</h2>
          <p>When the system is armed, a sensor such as Ajax DoorProtect detects an opening and tells the hub.</p>
        </div>
      </div>
    </article>
    <article id="signal-hub" class="alarm-scene alarm-scene--hub" aria-labelledby="signal-title-hub" data-alarm-scene data-layer="inactive">
      <div class="shell alarm-scene__inside">
        <figure class="alarm-scene__hardware" data-hub-stage>
          <img src={route('images/story/devices/hub-2.webp')} alt="A square Ajax Hub 2 alarm control panel" width="820" height="650" decoding="async" loading="lazy" />
          <canvas data-hub-canvas aria-hidden="true"></canvas>
        </figure>
        <div class="alarm-scene__copy">
          <p class="signal-eyebrow">Ajax Hub 2</p>
          <h2 id="signal-title-hub">The signal<br class="alarm-line-break" /> goes out.</h2>
          <p>The hub connects the devices around your property. With monitoring, it sends the alert to the monitoring centre.</p>
        </div>
      </div>
    </article>
    <article id="signal-response" class="alarm-scene alarm-scene--response" aria-labelledby="signal-title-response" data-alarm-scene data-layer="inactive">
      <div class="alarm-scene__field" aria-hidden="true">
        <img src={route('images/story/response-still.webp')} alt="" width="1120" height="770" decoding="async" loading="lazy" />
      </div>
      <div class="shell alarm-scene__inside">
        <div class="alarm-scene__copy">
          <p class="signal-eyebrow">24/7 monitoring</p>
          <h2 id="signal-title-response">A person<br class="alarm-line-break" /> answers.</h2>
          <p>An operator sees which alarm came in and follows the contact instructions you’ve set for your property.</p>
        </div>
        <div class="alarm-scene__notice" aria-hidden="true">
          <span>Monitoring centre</span>
          <strong>Alert received.</strong>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  import { initializeSignalStory } from '../scripts/signal-story';

  const story = document.querySelector<HTMLElement>('[data-alarm-film]');
  if (story) initializeSignalStory(story);
</script>
