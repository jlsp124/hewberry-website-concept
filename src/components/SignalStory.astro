---
import { route } from '../lib/site';

const chapters = [
  {
    key: 'door',
    label: 'Detection',
    title: 'The door opens.',
    text: 'When the alarm is armed, the door sensor detects the opening and tells the system.',
    model: 'Ajax DoorProtect',
    image: 'door-still.webp',
    alt: 'An Ajax sensor and magnet on opposite sides of a door frame',
  },
  {
    key: 'hub',
    label: 'Alert',
    title: 'The signal goes out.',
    text: 'The hub connects the equipment at your property. If you have monitoring, it sends the alert to the monitoring centre.',
    model: 'Ajax Hub 2',
    image: 'hub-still.webp',
    alt: 'An Ajax Hub with a smooth square face and rounded corners',
  },
  {
    key: 'response',
    label: '24/7 monitoring',
    title: 'A person answers.',
    text: 'An operator sees which alarm came in and follows the contact instructions you’ve set for your property.',
    model: 'Monitoring example',
    image: 'response-still.webp',
    alt: 'A phone showing an Ajax system beside its alarm hub',
  },
];
---

<section class="signal-story" id="system" data-signal-story aria-label="How a monitored alarm works">
  <div class="signal-stage" aria-hidden="true" data-signal-stage hidden><canvas data-signal-canvas></canvas></div>
  <div class="shell signal-steps">
    {chapters.map(({ key, label, title, text, model, image, alt }, index) => (
      <article id={`signal-${key}`} class:list={['signal-step', `signal-step--${key}`]} data-signal-step={index} aria-labelledby={`signal-title-${key}`}>
        <div class="signal-step__body">
          <p class="story-label">{label}</p>
          <h2 id={`signal-title-${key}`}>{title}</h2>
          <p class="signal-step__text">{text}</p>
          {key === 'door' && (
            <button class="signal-step__action" type="button" data-signal-door hidden>
              <span class="signal-step__action-icon" aria-hidden="true">↗</span><span data-signal-door-label>Open the door</span>
            </button>
            <p class="visually-hidden" data-signal-door-announcement role="status"></p>
          )}
        </div>
        <figure class="signal-step__image">
          <div class="signal-shot" data-signal-slot={key}>
            <img src={route('images/story/' + image)} alt={alt} width="960" height="640" loading="lazy" decoding="async" />
            {key === 'response' && <div class="signal-receipt" aria-hidden="true">
              <div class="signal-receipt__route"><span></span> Monitoring centre</div>
              <strong>Front door alarm</strong>
              <p>Alert received · Contact plan started</p>
            </div>}
          </div>
          <figcaption>
            <span>{model}</span>
            {key === 'door' && <span class="signal-stage__status" data-signal-status-label hidden>Door closed</span>}
          </figcaption>
        </figure>
      </article>
    ))}
  </div>
</section>

<script>
  import { initializeSignalStory } from '../scripts/signal-story';

  const story = document.querySelector<HTMLElement>('[data-signal-story]');
  if (story) initializeSignalStory(story);
</script>
