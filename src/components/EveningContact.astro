---
import { company, route } from '../lib/site';
---

<section class="arrival-close" id="services" aria-labelledby="arrival-close-title">
  <div class="shell arrival-close__inner">
    <div>
      <blockquote>“Hewberry Alarms provided excellent and timely service, advising us on the best options for our new home…”</blockquote>
      <p class="arrival-close__credit"><strong>Jack Ledbetter</strong> · Homeowner</p>
    </div>
    <div id="contact" class="arrival-close__next">
      <h2 id="arrival-close-title">Let’s talk security.</h2>
      <a href={route('systems/')}>Explore systems <span aria-hidden="true">↗</span></a>
      <a href={route('contact/')}>Contact Hewberry <span aria-hidden="true">↗</span></a>
      <a class="arrival-close__phone" href={company.telephone}>{company.phone}</a>
    </div>
  </div>
</section>
