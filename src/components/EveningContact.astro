---
import { company, route } from '../lib/site';
---

<section class="evening-contact" id="contact" tabindex="-1" aria-labelledby="evening-contact-title">
  <picture class="evening-contact__photo">
    <source media="(max-width: 680px)" srcset={route('images/story/valley-720.webp')} />
    <img src={route('images/story/valley-1920.webp')} alt="Evening light over the water near Vernon" width="1920" height="1080" loading="lazy" decoding="async" />
  </picture>
  <div class="evening-contact__shade" aria-hidden="true"></div>
  <div class="evening-contact__echo" aria-hidden="true"></div>
  <div class="shell evening-contact__inner">
    <div>
      <h2 id="evening-contact-title">Let’s talk security.</h2>
      <p>Tell us what you’d like to protect. We’ll talk through your property and what an installation could look like.</p>
    </div>
    <div class="evening-contact__actions">
      <a class="evening-contact__quote" href={route('quote/')}>Get a quote <span aria-hidden="true">↗</span></a>
      <a class="evening-contact__phone" href={company.telephone}>{company.phone}</a>
    </div>
  </div>
</section>

<script>
  const close = document.querySelector<HTMLElement>('.evening-contact');
  const echo = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  if (close) {
    close.addEventListener('pointermove', (event) => {
      if (!echo.matches || event.pointerType !== 'mouse') return;
      const frame = close.getBoundingClientRect();
      close.dataset.echo = '';
      close.style.setProperty('--echo-x', `${(event.clientX - frame.x) / frame.width * 100}%`);
      close.style.setProperty('--echo-y', `${46 + (event.clientY - frame.y) / frame.height * 40}%`);
    }, { passive: true });
    close.addEventListener('pointerleave', () => { delete close.dataset.echo; });
    echo.addEventListener('change', () => { delete close.dataset.echo; });
  }
</script>
