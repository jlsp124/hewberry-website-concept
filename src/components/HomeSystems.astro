---
import { route } from '../lib/site';

const installations = [
  { mark: 'alarm', title: 'Alarms', benefit: 'Know when a door opens or there’s movement.', link: 'residential/' },
  { mark: 'video', title: 'Cameras', benefit: 'Check live video and look back at what happened.', link: 'commercial/' },
  { mark: 'access', title: 'Door access', benefit: 'Choose who can get in and when.', link: 'commercial/' },
  { mark: 'environment', title: 'Smoke and water detection', benefit: 'Get an early warning for smoke or a water leak.', link: 'residential/' },
  { mark: 'wiring', title: 'Pre-wiring', benefit: 'Get the wiring in before the walls close.', link: 'construction/' },
  { mark: 'watch', title: '24/7 alarm monitoring', benefit: 'Have a person receive alerts when you’re away.', link: 'monitoring/' },
];
---
<section class="home-systems" id="services" tabindex="-1" aria-labelledby="services-title">
  <div class="shell">
    <div class="home-systems__intro">
      <h2 id="services-title">What we install.</h2>
      <p>For a home, a business or a build already underway.</p>
    </div>
    <table class="systems-table">
      <caption class="visually-hidden">Security installation and monitoring services</caption>
      <thead>
        <tr><th scope="col">System</th><th scope="col">What it does</th></tr>
      </thead>
      <tbody>
        {installations.map(({ mark, title, benefit, link }) => (
          <tr>
            <th scope="row">
              <a href={route(link)}>
                <span class:list={['system-mark', 'system-mark--' + mark]} aria-hidden="true"></span>
                <span>{title}</span><span aria-hidden="true" class="system-arrow">↗</span>
              </a>
            </th>
            <td>{benefit}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="systems-note">Considering Ajax? <a href={route('technology/#ajax-equipment')}>See equipment examples and what they do <span aria-hidden="true">↗</span></a></p>
  </div>
</section>
