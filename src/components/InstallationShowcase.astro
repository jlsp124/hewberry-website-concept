---
import { route } from '../lib/site';

const services = [
  { title: 'Homes', href: 'residential/', detail: 'Alarms, cameras and monitoring for the place you come home to.', image: 'home', alt: 'Exterior of a modern home with a security device under the roofline' },
  { title: 'Businesses', href: 'commercial/', detail: 'Alarms, video and door access for the way your team works.', image: 'business', alt: 'A security keypad at a commercial entry' },
  { title: 'New builds', href: 'construction/', detail: 'Alarm, access and network wiring while the walls are open.', image: 'build', alt: 'Timber framing inside a building under construction' },
];
---

<section class="installation" id="services" tabindex="-1" aria-labelledby="installation-title" data-installation>
  <div class="shell">
    <div class="installation__intro">
      <h2 id="installation-title">We plan it.<br /><em>We install it.</em></h2>
      <p>Every property needs something different. Hewberry helps you choose what to cover, installs the system, and shows you how to use it.</p>
    </div>

    <div class="installation__index">
      <div class="installation__preview" aria-hidden="true" data-installation-preview>
        {services.map(({ image, alt }, index) => (
          <picture class:list={[index === 0 && 'is-current']} data-installation-image={index}>
            <source srcset={`${route(`images/story/${image}-700.webp`)} 700w, ${route(`images/story/${image}-1400.webp`)} 1400w`} sizes="(min-width: 900px) 52vw, 100vw" />
            <img src={route(`images/story/${image}-700.webp`)} alt={alt} width="1400" height="880" loading="lazy" decoding="async" />
          </picture>
        ))}
      </div>

      <div class="installation__choices">
        {services.map(({ title, href, detail, image }, index) => (
          <article class="installation__choice" data-installation-choice={index}>
            <img class="installation__thumb" src={route(`images/story/${image}-700.webp`)} alt="" width="700" height="440" loading="lazy" decoding="async" />
            <div>
              <h3><a href={route(href)}>{title}<span aria-hidden="true">↗</span></a></h3>
              <p>{detail}</p>
            </div>
          </article>
        ))}
        <a class="installation__equipment" href={route('technology/#ajax-equipment')}>Browse equipment examples <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-installation]');
  if (section) {
    const preview = section.querySelector<HTMLElement>('[data-installation-preview]');
    const images = section.querySelectorAll<HTMLElement>('[data-installation-image]');
    const rows = section.querySelectorAll<HTMLElement>('[data-installation-choice]');
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const large = matchMedia('(min-width: 900px)');
    let current = 0;
    let sequence = 0;

    async function choose(index: number) {
      const request = ++sequence;
      const next = images[index];
      if (!preview || !large.matches || !next || index === current) return;
      const image = next.querySelector('img');
      if (image) {
        try { await image.decode(); } catch { return; }
      }
      if (request !== sequence || !large.matches) return;
      images.forEach((item, number) => item.classList.toggle('is-previous', number === current));
      images[current].classList.remove('is-current');
      next.classList.add('is-current');
      current = index;
      if (motion.matches && typeof next.animate === 'function') {
        next.getAnimations().forEach((animation) => animation.cancel());
        next.animate([{ clipPath: 'inset(0 0 100% 0)', opacity: .65 }, { clipPath: 'inset(0)', opacity: 1 }],
          { duration: 340, easing: 'cubic-bezier(.21,.66,.26,1)' });
      }
    }

    rows.forEach((row, index) => {
      row.addEventListener('pointerenter', () => { void choose(index); });
      row.addEventListener('focusin', () => { void choose(index); });
    });
  }
</script>
