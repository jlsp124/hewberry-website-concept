---
import { ajaxDevices, ajaxGroups } from '../lib/ajax-devices';
import { route } from '../lib/site';

const firstDevice = ajaxDevices[0];
const installServices = [
  { label: 'Homes', text: 'New alarms, cameras and upgrades for the place you come home to.', image: 'home-700.webp', url: 'residential/' },
  { label: 'Businesses', text: 'Alarms, video and door access for the way your team works.', image: 'business-700.webp', url: 'commercial/' },
  { label: 'New builds', text: 'Alarm, access and network wiring while the walls are open.', image: 'build-700.webp', url: 'construction/' },
];
---

<section class="system-index" id="services" tabindex="-1" aria-labelledby="systems-title" data-equipment-index>
  <div class="shell">
    <div class="system-index__intro">
      <h2 id="systems-title">What we install.</h2>
      <p>Door sensors, cameras and more. See how the pieces of an Ajax system fit together.</p>
    </div>

    <div class="system-index__layout">
      <figure class="equipment-view" aria-hidden="true">
        <img src={route(`images/story/devices/${firstDevice.id}.webp`)}
          width="820" height="650" alt="" loading="lazy" decoding="async" data-equipment-view-image />
        <figcaption><span>Ajax Systems</span><strong data-equipment-view-name>{firstDevice.name}</strong></figcaption>
      </figure>

      <div class="equipment-list">
        <div class="equipment-filter" role="group" aria-label="Equipment category" hidden data-equipment-filter>
          {ajaxGroups.map(({ id, label }) => (
            <button type="button" aria-controls="equipment-options" aria-pressed={id === firstDevice.group ? 'true' : 'false'} data-equipment-category={id}>{label}</button>
          ))}
        </div>
        <table id="equipment-options" class="equipment-options">
          <caption class="visually-hidden">Ajax equipment examples and their uses</caption>
          <thead><tr><th scope="col">Equipment</th><th scope="col">What it does</th></tr></thead>
          <tbody>
            {ajaxDevices.map((device) => (
              <tr data-equipment-row={device.group}
                data-device={device.name}
                data-device-image={route(`images/story/devices/${device.id}.webp`)}>
                <th scope="row">
                  <span>
                    <img src={route(`images/story/devices/${device.id}-thumb.webp`)} width="116" height="90" alt="" loading="lazy" decoding="async" />
                    {device.name}
                  </span>
                </th>
                <td>{device.purpose}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="equipment-list__note">Equipment shown is representative. Hewberry can help choose what fits your property.</p>
      </div>
    </div>
    <div class="installation-types" aria-label="Installation services">
      {installServices.map(({ label, text, image, url }) => (
        <article class="installation-type">
          <img src={route('images/story/' + image)} alt="" width="700" height="440" loading="lazy" decoding="async" />
          <div class="installation-type__copy">
            <h3><a href={route(url)}>{label}<span aria-hidden="true">↗</span></a></h3>
            <p>{text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const equipment = document.querySelector<HTMLElement>('[data-equipment-index]');
  const filters = equipment?.querySelector<HTMLElement>('[data-equipment-filter]');
  const buttons = filters?.querySelectorAll<HTMLButtonElement>('[data-equipment-category]');
  const rows = equipment?.querySelectorAll<HTMLTableRowElement>('[data-equipment-row]');
  const image = equipment?.querySelector<HTMLImageElement>('[data-equipment-view-image]');
  const name = equipment?.querySelector<HTMLElement>('[data-equipment-view-name]');
  const previewPointer = matchMedia('(hover: hover) and (pointer: fine)');
  const previewScreen = matchMedia('(min-width: 900px)');

  if (filters && buttons?.length && rows?.length && image && name) {
    function show(row: HTMLTableRowElement) {
      const source = row.dataset.deviceImage;
      if (!source || !previewScreen.matches || !image || !name) return;
      image.dataset.requested = source;
      if (image.getAttribute('src') === source) return;
      const next = new Image();
      next.src = source;
      void next.decode().then(() => {
        if (image.dataset.requested !== source) return;
        image.src = source;
        name.textContent = row.dataset.device ?? '';
      }).catch(() => {});
    }

    function choose(button: HTMLButtonElement) {
      buttons?.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      rows?.forEach((row) => { row.hidden = row.dataset.equipmentRow !== button.dataset.equipmentCategory; });
      const first = Array.from(rows ?? []).find((row) => !row.hidden);
      if (first) show(first);
    }

    buttons.forEach((button) => button.addEventListener('click', () => choose(button)));
    rows.forEach((row) => row.addEventListener('pointerenter', () => {
      if (previewPointer.matches) show(row);
    }));
    previewScreen.addEventListener('change', () => {
      const active = Array.from(buttons).find((button) => button.getAttribute('aria-pressed') === 'true');
      if (active) choose(active);
    });
    choose(buttons[0]);
    filters.hidden = false;
  }
</script>
