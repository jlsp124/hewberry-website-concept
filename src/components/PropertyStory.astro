---
import { route } from '../lib/site';
import AlertExample from './AlertExample.astro';
---
<section class="property-journey" data-property-journey aria-labelledby="home-title">
  <div class="journey-stage" data-journey-stage data-beat="dusk" aria-hidden="true">
    <picture class="journey-picture">
      <source
        media="(orientation: portrait) and (max-width: 720px)"
        srcset={route('images/night-home-portrait-480.webp') + ' 480w, ' + route('images/night-home-portrait-800.webp') + ' 800w'}
        sizes="100vw"
      />
      <img
        src={route('images/night-home-1600.webp')}
        srcset={route('images/night-home-960.webp') + ' 960w, ' + route('images/night-home-1600.webp') + ' 1600w, ' + route('images/night-home-2240.webp') + ' 2240w'}
        sizes="100vw"
        width="1600"
        height="1067"
        fetchpriority="high"
        alt=""
      />
    </picture>
    <div class="journey-grade"></div>
    <div class="journey-sheen"></div>
    <div class="journey-trace">
      <p>Example signal</p>
      <div class="journey-trace__rail"><span></span></div>
      <div class="journey-trace__endpoints"><span>Door sensor</span><span>Monitoring centre</span></div>
    </div>
  </div>
  <div class="journey-content">
    <section class="journey-opening" aria-labelledby="home-title">
      <div class="shell journey-opening__inner">
        <div class="journey-opening__copy">
          <h1 id="home-title">
            <span class="journey-years">25 years</span>
            <span class="journey-heading">of experience<br />keeping you safe.</span>
          </h1>
          <p>Security systems, cameras and 24/7 alarm monitoring for homes and businesses.</p>
        </div>
        <div class="journey-opening__foot">
          <span class="journey-photo-label">Illustrative property</span>
          <span class="journey-scroll" aria-hidden="true">Scroll <span>↓</span></span>
        </div>
      </div>
    </section>
    <section id="system" class="journey-chapter" aria-labelledby="door-heading" tabindex="-1">
      <div class="shell journey-chapter__inner">
        <div class="journey-chapter__copy">
          <p class="journey-key"><span aria-hidden="true"></span> Door sensor</p>
          <h2 id="door-heading">Someone opens the door.</h2>
          <p>If the system is armed, a door sensor tells the alarm panel that a protected door has opened.</p>
        </div>
      </div>
    </section>
    <section id="system-monitor" class="journey-chapter journey-chapter--response" aria-labelledby="call-heading" tabindex="-1">
      <div class="shell journey-chapter__inner">
        <div class="journey-chapter__copy">
          <p class="journey-key"><span aria-hidden="true"></span> 24/7 alarm monitoring</p>
          <h2 id="call-heading">Someone gets the alert.</h2>
          <p>Your alarm alerts a monitoring centre. An operator checks the alert and follows the instructions you set, which may include calling you or another contact.</p>
          <AlertExample />
        </div>
      </div>
    </section>
  </div>
</section>
<script>
  import { initializePropertyStory } from '../scripts/property-story';
  initializePropertyStory();
</script>
