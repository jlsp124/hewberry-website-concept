---
import Brand from './Brand.astro';
import { company, route } from '../lib/site';
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <Brand />
        <p>Security installation and monitoring.<br />Based in Vernon, British Columbia.</p>
      </div>
      <nav aria-label="Services" class="footer-links">
        <h2>Services</h2>
        <a href={route('residential/')}>Residential security</a>
        <a href={route('commercial/')}>Commercial security</a>
        <a href={route('construction/')}>Construction and pre-wiring</a>
        <a href={route('monitoring/')}>24/7 monitoring</a>
        <a href={route('technology/')}>Equipment and upgrades</a>
      </nav>
      <nav aria-label="Company" class="footer-links">
        <h2>Company</h2>
        <a href={route('about/')}>About Hewberry</a>
        <a href={route('about/#service-area')}>Service area</a>
        <a href={route('support/')}>Customer support</a>
        <a href={route('support/#faqs')}>FAQs</a>
        <a href={route('quote/')}>Get a quote</a>
      </nav>
      <div class="footer-links">
        <h2>Vernon office</h2>
        <a href={company.telephone}>{company.phone}</a>
        <a href={'mailto:' + company.email}>{company.email}</a>
        <a class="footer-address" href={company.map}>3410 28th Ave <span aria-hidden="true">↗</span><br />Vernon, BC V1T 1W9</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Website preview. Quote submissions are simulated.</p>
    </div>
  </div>
</footer>
