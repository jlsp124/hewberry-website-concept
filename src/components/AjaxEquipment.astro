---
import { ajaxDevices } from '../lib/ajax-devices';
import { route } from '../lib/site';
---
<section id="ajax-equipment" class="detail-list section-space" aria-labelledby="ajax-title">
  <div class="shell detail-layout">
    <div>
      <p class="eyebrow">Ajax Systems</p>
      <h2 class="display" id="ajax-title">Equipment to ask about.</h2>
      <p>Hewberry can help choose the right combination of detection, cameras and controls for your property.</p>
      <a class="inline-link" href={route('#services')}>See the equipment guide <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="equipment-table">
      {ajaxDevices.map(({ name, purpose }) => (
        <div><dt>{name}</dt><dd>{purpose}</dd></div>
      ))}
    </dl>
  </div>
</section>
