---
const examples = [
  { model: 'DoorProtect', purpose: 'Detects an opening door or window.' },
  { model: 'MotionProtect', purpose: 'Detects movement indoors.' },
  { model: 'IndoorCam', purpose: 'Shows live video inside a property.' },
  { model: 'FireProtect 2', purpose: 'Detects smoke and heat. Some versions also detect carbon monoxide.' },
  { model: 'LeaksProtect', purpose: 'Alerts you to water where it shouldn’t be.' },
];
---
<section id="ajax-equipment" class="detail-list section-space" aria-labelledby="ajax-title">
  <div class="shell detail-layout">
    <div>
      <p class="eyebrow">Ajax Systems</p>
      <h2 class="display" id="ajax-title">Equipment to ask about.</h2>
      <p>These examples show what Ajax makes. Hewberry can confirm which models are available and suitable for your property.</p>
    </div>
    <dl class="equipment-table">
      {examples.map(({ model, purpose }) => (
        <div><dt>{model}</dt><dd>{purpose}</dd></div>
      ))}
    </dl>
  </div>
</section>
