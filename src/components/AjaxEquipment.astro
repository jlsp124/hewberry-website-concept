---
import { ajaxDevices, ajaxGroups } from '../lib/ajax-devices';
import { route } from '../lib/site';
import '../styles/equipment.css';

const categories = [{ id: 'all', label: 'All' }, ...ajaxGroups];
const contexts: Record<string, string> = {
  doorprotect: 'door-still.webp',
  'hub-2': 'hub-still.webp',
  'keypad-plus': 'business-1400.webp',
  motioncam: 'motioncam-installed.webp',
  turretcam: 'turretcam-installed.webp',
};
---

<section class="equipment-gallery" id="equipment" aria-labelledby="equipment-title" data-equipment-gallery>
  <div class="shell">
    <div class="equipment-gallery__intro">
      <h2 id="equipment-title">A closer look.</h2>
      <p>Examples from Ajax Systems, from a sensor at the door to the hub that connects it all.</p>
    </div>
    <div class="equipment-gallery__filters" role="group" aria-label="Equipment category" data-gallery-filters hidden>
      {categories.map(({ id, label }) => (
        <button type="button" data-gallery-filter={id} aria-controls="equipment-collection" aria-pressed={id === 'all' ? 'true' : 'false'}>{label}</button>
      ))}
    </div>
    <p class="visually-hidden" data-gallery-count role="status"></p>
    <ul class="equipment-collection" id="equipment-collection">
      {ajaxDevices.map((device, index) => (
        <li data-gallery-item={device.group} data-wide={String(index % 4 === 0 || index % 4 === 3)}>
          <figure>
            <div class="equipment-card__media" data-gallery-media>
              <img class="equipment-card__image" src={route(`images/story/devices/${device.id}.webp`)} alt={`Ajax ${device.name}`} width="820" height="650" loading="lazy" decoding="async" />
              {contexts[device.id] && <img class="equipment-card__context" src={route(`images/story/${contexts[device.id]}`)} alt="" width="1120" height="770" loading="lazy" decoding="async" />}
            </div>
            <figcaption class="equipment-card__caption">
              <h3>{device.name}</h3>
              <p>{device.purpose}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-equipment-gallery]');
  if (gallery) {
    const filters = gallery.querySelector<HTMLElement>('[data-gallery-filters]');
    const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
    const items = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-item]'));
    const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');
    const precision = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    let selection = 0;

    for (const button of buttons) {
      button.addEventListener('click', async () => {
        const filter = button.dataset.galleryFilter;
        const request = ++selection;
        const matches = items.filter((item) => filter === 'all' || item.dataset.galleryItem === filter);
        await Promise.all(matches.slice(0, 2).map(async (item) => {
          const image = item.querySelector<HTMLImageElement>('.equipment-card__image');
          if (!image) return;
          image.loading = 'eager';
          try { await image.decode(); } catch { /* The caption remains available if its image fails. */ }
        }));
        if (request !== selection) return;
        let shown = 0;
        for (const item of items) {
          item.hidden = filter !== 'all' && item.dataset.galleryItem !== filter;
          if (!item.hidden) {
            item.dataset.wide = String(shown % 4 === 0 || shown % 4 === 3);
            shown++;
          }
        }
        buttons.forEach((choice) => choice.setAttribute('aria-pressed', String(choice === button)));
        if (count) count.textContent = `${shown} equipment examples shown.`;
      });
    }
    if (filters) filters.hidden = false;

    gallery.addEventListener('pointermove', (event) => {
      if (!precision.matches || event.pointerType !== 'mouse' || !(event.target instanceof Element)) return;
      const media = event.target.closest<HTMLElement>('[data-gallery-media]');
      if (!media) return;
      const bounds = media.getBoundingClientRect();
      // Relative pointer coordinates adapted from ObsidianUI's MIT hover image effect.
      const x = Math.max(0, Math.min(bounds.width, event.clientX - bounds.left));
      media.style.setProperty('--equipment-reveal', `${x / bounds.width * 40 + 48}%`);
    }, { passive: true });
  }
</script>
