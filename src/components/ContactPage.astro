---
import Site from '../layouts/Site.astro';
import { company, route } from '../lib/site';
import '../styles/contact.css';

interface Props {
  title?: string;
}
const { title = 'Contact' } = Astro.props;
---

<Site title={title} description="Contact Hewberry Alarms in Vernon about installation, monitoring or service.">
  <section class="contact-page shell" aria-labelledby="contact-title">
    <div class="contact-page__intro">
      <h1 id="contact-title">{title === 'Get a quote' ? 'Get a quote.' : 'Get in touch.'}</h1>
      <p>Tell us what you’d like to protect. We’ll help you figure out what fits your property.</p>
    </div>

    <form class="contact-form" method="post" data-contact-form hidden>
      <fieldset disabled>
        <label for="contact-name">Name</label>
        <input id="contact-name" type="text" autocomplete="name" maxlength="100" required />
        <label for="contact-email">Email</label>
        <input id="contact-email" type="email" autocomplete="email" maxlength="254" required />
        <label for="contact-phone">Phone <span>optional</span></label>
        <input id="contact-phone" type="tel" autocomplete="tel" maxlength="40" />
        <label for="contact-message">Message</label>
        <textarea id="contact-message" rows="4" maxlength="2000" data-contact-message required></textarea>
        <div class="contact-form__actions">
          <button class="action-link" type="submit">Send message <span aria-hidden="true">↗</span></button>
          <p>Demo form. Messages stay on this page.</p>
        </div>
        <p class="contact-form__result" data-contact-result role="status"></p>
      </fieldset>
    </form>
    <div class="contact-page__details">
      <address class="contact-page__office">
        <a href={company.telephone}>{company.phone}</a>
        <a href={'mailto:' + company.email}>{company.email}</a>
        <a class="contact-page__address" href={company.map}>
          3410 28th Ave<br />Vernon, BC V1T 1W9 <span aria-hidden="true">↗</span>
        </a>
      </address>
      <a class="contact-page__support" href={route('support/')}>Support for existing customers <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Site>

<script>
  import { priorities, properties } from '../lib/quote';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const fields = form?.querySelector('fieldset');
  const message = form?.querySelector<HTMLTextAreaElement>('[data-contact-message]');
  const result = form?.querySelector<HTMLElement>('[data-contact-result]');
  if (form && fields && message && result) {
    const query = new URLSearchParams(location.search);
    const property = properties.find((option) => option.value === query.get('property'));
    const priority = priorities.find((option) => option.value === query.get('priority'));
    const details = [property?.label, priority?.label].filter(Boolean);
    if (details.length) message.value = `${details.join(' · ')}\n\n`;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      result.textContent = 'Demo message complete. To reach Hewberry, call or email the office.';
    });
    form.addEventListener('input', () => { result.textContent = ''; });
    fields.disabled = false;
    form.hidden = false;
  }
</script>
