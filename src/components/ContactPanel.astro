---
import { company, route } from '../lib/site';
---
<section id="contact" class="contact-finale" data-contact-finale tabindex="-1" aria-labelledby="contact-title">
  <div class="contact-finale__light" aria-hidden="true"></div>
  <div class="shell contact-finale__inner">
    <h2 id="contact-title"><span>Talk to</span><span>Hewberry<span class="contact-finale__period">.</span></span></h2>
    <div class="contact-finale__details">
      <p>Tell us what you want to protect. We’ll talk through the property, your options and what installation involves.</p>
      <a class="contact-finale__phone" href={company.telephone}>{company.phone}</a>
      <div class="contact-finale__links">
        <a class="button button--amber" href={route('quote/')}>Try the quote form <span aria-hidden="true">↗</span></a>
        <a class="inline-link" href={route('support/')}>Existing customer support <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
<script>
  const finale = document.querySelector<HTMLElement>('[data-contact-finale]');
  const reactive = matchMedia('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)');
  if (finale) {
    let frame = 0;
    let x = 0;
    let y = 0;
    finale.addEventListener('pointermove', (event) => {
      if (!reactive.matches || event.pointerType !== 'mouse') return;
      x = event.clientX;
      y = event.clientY;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const rect = finale.getBoundingClientRect();
        finale.style.setProperty('--contact-light-x', ((x - rect.left) / rect.width * 100).toFixed(2) + '%');
        finale.style.setProperty('--contact-light-y', ((y - rect.top) / rect.height * 100).toFixed(2) + '%');
      });
    }, { passive: true });
  }
</script>
