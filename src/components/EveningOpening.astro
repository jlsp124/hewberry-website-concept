---
import { route } from '../lib/site';
---

<section class="arrival" aria-labelledby="arrival-title" data-arrival>
  <div class="arrival__frame" aria-hidden="true">
    <picture>
      <source media="(max-width: 650px)" type="image/avif" srcset={route('images/story/estate-portrait.avif')} />
      <source media="(max-width: 650px)" srcset={route('images/story/estate-portrait.webp')} />
      <img src={route('images/story/estate-poster.webp')} width="1840" height="1036" fetchpriority="high" alt="" />
    </picture>
    <video data-arrival-film data-src={route('images/story/estate-motion.mp4')} muted playsinline preload="none"></video>
  </div>
  <div class="arrival__grade" aria-hidden="true"></div>
  <div class="shell arrival__inner">
    <h1 id="arrival-title">
      <span><span>Security where</span></span>
      <span><span>we live and work.</span></span>
    </h1>
    <div class="arrival__bottom">
      <p>Alarm and camera installation. 24/7 monitoring.<br />Over 25 years of experience in the Okanagan.</p>
      <span class="arrival__cue" aria-hidden="true">Scroll to follow an alarm <span>↓</span></span>
    </div>
  </div>
</section>

<script>
  import { clamp, seekOnScroll } from '../scripts/scroll-media';

  const section = document.querySelector<HTMLElement>('[data-arrival]');
  const film = section?.querySelector<HTMLVideoElement>('[data-arrival-film]');
  if (section && film) {
    const seek = seekOnScroll(film);
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    let frame = 0;
    function update() {
      frame = 0;
      if (!section || !motion.matches) return;
      const rect = section.getBoundingClientRect();
      const masthead = document.querySelector('header')?.getBoundingClientRect().bottom ?? 0;
      if (rect.bottom <= masthead || rect.top >= innerHeight) return;
      const progress = clamp((masthead - rect.top) / rect.height);
      section.style.setProperty('--arrival-lift', `${progress * -18}%`);
      section.style.setProperty('--arrival-dark', String(progress * .26));
      if (progress > .015) seek(progress * .97);
    }
    function schedule() {
      if (!frame && motion.matches) frame = requestAnimationFrame(update);
    }
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    motion.addEventListener('change', schedule);
    schedule();
  }
</script>
