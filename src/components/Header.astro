---
import Brand from './Brand.astro';
import { route } from '../lib/site';

const path = Astro.url.pathname;
const contact = path === route('contact/') || path === route('quote/');
const systems = ['systems/', 'residential/', 'commercial/', 'construction/', 'monitoring/', 'technology/']
  .some((page) => path === route(page));
---
<header class="site-header">
  <div class="shell site-header__inner">
    <Brand />
    <nav class="primary-nav" aria-label="Main">
      <a href={route('systems/')} aria-current={path === route('systems/') ? 'page' : systems ? 'location' : undefined}>Systems</a>
      <a href={route('contact/')} aria-current={path === route('contact/') ? 'page' : contact ? 'location' : undefined}>Contact</a>
    </nav>
  </div>
</header>
