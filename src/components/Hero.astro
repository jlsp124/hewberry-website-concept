---
import { route } from '../lib/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__inner">
    <p class="eyebrow hero__location">Vernon, British Columbia</p>
    <h1 id="hero-title">Security <span class="hero__phrase">that answers<span class="hero__period">.</span></span></h1>
    <div class="hero__rail">
      <p class="hero__intro">Hewberry Alarms installs security systems for homes and businesses, with 24/7 monitoring in the Okanagan.</p>
      <div class="hero__actions">
        <a class="button button--amber" href={route('quote/')}>Get a quote <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="inline-link" href="#system">See how it works <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
  <figure class="shell hero__visual">
    <div class="hero__scene">
      <picture class="hero__picture">
        <source
          media="(max-width: 600px)"
          srcset={route('images/hero-mobile-480.webp') + ' 480w, ' + route('images/hero-mobile-800.webp') + ' 800w'}
          sizes="calc(100vw - 44px)"
        />
        <img
          src={route('images/hero-1440.webp')}
          srcset={route('images/hero-960.webp') + ' 960w, ' + route('images/hero-1440.webp') + ' 1440w, ' + route('images/hero-1920.webp') + ' 1920w'}
          sizes="(min-width: 1778px) 1600px, 90vw"
          width="1440"
          height="960"
          fetchpriority="high"
          alt="A contemporary home glowing with warm light at dusk"
        />
      </picture>
    </div>
    <figcaption class="hero__caption">
      <a href={route('photo-credits/#home-at-dusk')}>Example property photograph <span aria-hidden="true">↗</span></a>
    </figcaption>
  </figure>
</section>
